#!/bin/bash

# shellcheck source=start-utils
. "${SCRIPTS:-$(dirname "$0")}/start-utils"
set -o pipefail
set -e
isDebugging && set -x

resolveVersion

if [ "${VERSION}" != "b1.7.3" ]; then
  logError "Poseidon server type only supports VERSION=b1.7.3"
  exit 1
fi

: "${POSEIDON_RELEASE:=latest}"
: "${POSEIDON_TYPE:=poseidon}"

# Only pass --release-tag when a specific release was requested; helper treats
# omitted as latest
poseidonReleaseArgs=()
[[ ${POSEIDON_RELEASE} == latest ]] || poseidonReleaseArgs+=(--release-tag="${POSEIDON_RELEASE}")

if [[ ${POSEIDON_TYPE^^} = UBERBUKKIT ]]; then
  poseidonRepo="Moresteck/uberbukkit"
else
  poseidonRepo="retromcorg/Project-Poseidon"
fi

poseidonReleasesUrl=https://github.com/${poseidonRepo}/releases

if ! SERVER=$(mc-image-helper github download-asset \
  "${poseidonReleaseArgs[@]}" \
  --output-directory=/data \
  --name-pattern="^(?!original-).+\.jar" \
  ${poseidonRepo}
  ); then
    logError "Failed to download ${POSEIDON_TYPE} release ${POSEIDON_RELEASE}"
    logError "Ensure POSEIDON_RELEASE is one of the releases at ${poseidonReleasesUrl}"
    exit 1
fi

export SERVER
export FAMILY=SPIGOT

exec "$(dirname "$0")/start-spiget" "$@"
