#!/bin/bash

# shellcheck source=start-utils
. "$(dirname "$0")/start-utils"
isDebugging && set -x

: "${KETTING_RELEASE:=latest}"

# Only pass --release-tag when a specific release was requested; helper treats
# omitted as latest
kettingReleaseArgs=()
[[ ${KETTING_RELEASE} == latest ]] || kettingReleaseArgs+=(--release-tag="${KETTING_RELEASE}")

if ! SERVER=$(mc-image-helper github download-asset \
  "${kettingReleaseArgs[@]}" \
  --output-directory=/data \
  --name-pattern="kettinglauncher-.+?(?<!-sources)\.jar" \
  kettingpowered/kettinglauncher
  ); then
    logError "Failed to download Ketting launcher release ${KETTING_RELEASE}"
    logError "Ensure KETTING_RELEASE is one of the releases at https://github.com/kettingpowered/kettinglauncher/releases"
    exit 1
fi

export SERVER

resolveVersion

EXTRA_ARGS+=" -minecraftVersion $VERSION"
if [[ ${KETTING_VERSION:-} ]]; then
  EXTRA_ARGS+=" -kettingVersion $KETTING_VERSION"
fi
if [[ ${FORGE_VERSION:-} ]]; then
  EXTRA_ARGS+=" -forgeVersion $FORGE_VERSION"
fi
export EXTRA_ARGS

export SERVER
export FAMILY=HYBRID
export HYBRIDTYPE=forge

exec "$(dirname "$0")/start-spiget" "$@"
