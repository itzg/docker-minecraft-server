#!/bin/bash

# shellcheck source=start-utils
. "${SCRIPTS:-$(dirname "$0")}/start-utils"
set -o pipefail
set -e
isDebugging && set -x

resolveVersion
: "${LEAF_BUILD:=LATEST}"

leafApiUrl="https://dl.leafmc.one/v3/projects/leaf"
userAgent="docker-minecraft-server (https://github.com/itzg/docker-minecraft-server)"
if [[ "${LEAF_BUILD^^}" == "LATEST" ]]; then
  LEAF_BUILD=latest
fi

if ! build=$(curl -fsSL -A "$userAgent" "${leafApiUrl}/versions/${VERSION}/builds/${LEAF_BUILD}"); then
  logError "Failed to fetch Leaf build ${LEAF_BUILD} for ${VERSION}"
  exit 1
fi

if ! filename=$(jq -er '.downloads["server:default"].name | select(type == "string" and length > 0)' <<< "$build") ||
   ! url=$(jq -er '.downloads["server:default"].url | select(type == "string" and startswith("https://"))' <<< "$build") ||
   [[ "$filename" != "$(basename "$filename")" || "$filename" == "." || "$filename" == ".." ]]; then
  logError "Invalid Leaf build download metadata"
  exit 1
fi

SERVER="/data/$filename"
if [[ ! -f "$SERVER" ]]; then
  tmp=$(mktemp /data/.leaf-download.XXXXXX)
  if ! curl -fSL -A "$userAgent" -o "$tmp" "$url"; then
    rm -f "$tmp"
    logError "Failed to download Leaf"
    exit 1
  fi
  mv -f "$tmp" "$SERVER"
fi

export FAMILY=SPIGOT
export SERVER

exec "$(dirname "$0")/start-spiget" "$@"
